# Upheld Clinical Revenue Integrity — local env
# cp .env.example .env

# Postgres (docker compose maps host 5436 → container 5432)
DATABASE_URL="postgresql://upheld:upheld@127.0.0.1:5436/upheld?schema=public"

# Cookie JWT — openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

NEXT_PUBLIC_APP_NAME="Upheld"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Free scan retention (days)
FREE_SCAN_RETENTION_DAYS=30

# Free Chart Scan rate limits (abuse controls)
FREE_SCAN_MAX_PER_HOUR=12
FREE_SCAN_MAX_PER_DAY=40
FREE_SCAN_MAX_PER_AGENCY_HOUR=60

# Cron purge: Authorization Bearer token for /api/cron/purge
# CRON_SECRET=

# Chart text encryption at rest (AES-256-GCM). Required for PHI Free Scan.
# openssl rand -hex 32
# CHART_ENCRYPTION_KEY=

# Optional: live LLM enrichment (xAI Grok). Default = deterministic only.
# AI_PROVIDER=mock
# XAI_API_KEY=
# XAI_MODEL=grok-3-latest

# Optional: email delivery via Resend (without key, emails are logged in server console)
# RESEND_API_KEY=
# EMAIL_FROM="Upheld <reports@getupheld.com>"
# Pilot lead notifications (defaults to ky@getupheld.com)
# PILOT_NOTIFY_EMAIL=ky@getupheld.com

# Stripe 30-day pilot checkout (optional — interest path works without)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PILOT_ENABLED=1

# Optional OCR for scanned PDFs (see docs/ocr.md)
# OCR_PROVIDER=webhook|azure|none
# OCR_WEBHOOK_URL=
# OCR_WEBHOOK_SECRET=
# OCR_WEBHOOK_TIMEOUT_MS=25000
# AZURE_DOC_INTEL_ENDPOINT=https://YOUR.cognitiveservices.azure.com
# AZURE_DOC_INTEL_KEY=

# Retrospective batch (agency)
# BATCH_MAX_CLAIMS=200
# BATCH_CHUNK_SIZE=8

# Optional agency wage index for Phase 2 period payment (default 1.0 = national)
# AGENCY_WAGE_INDEX=1.0

# Demo seed only for non-PHI environments
ALLOW_DEMO_SEED=true
