# Production env template (Vercel / host secrets — do not commit real values)

NODE_ENV=production

# Managed Postgres (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/upheld?sslmode=require"

# Required — openssl rand -base64 48
SESSION_SECRET=""

NEXT_PUBLIC_APP_NAME="Upheld"
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN.vercel.app"

FREE_SCAN_RETENTION_DAYS=30

# Demo seed: only true on non-PHI demo environments
ALLOW_DEMO_SEED=false

# Optional LLM enrichment
# AI_PROVIDER=xai
# XAI_API_KEY=
# XAI_MODEL=grok-3-latest

# Optional email
# RESEND_API_KEY=
# EMAIL_FROM="Upheld <reports@getupheld.com>"
